# Environment Configuration for AI Office IT Help Desk Backend
PROJECT_NAME="AI Office IT Help Desk"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 5432)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ai_helpdesk
# Async connection string for SQLAlchemy asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@localhost:5432/ai_helpdesk
# Sync connection string for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/ai_helpdesk

# Security & JWT
JWT_SECRET=super_secret_jwt_key_ai_office_it_helpdesk_change_in_prod_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# CORS Settings (Allow Flutter web & mobile dev clients)
CORS_ORIGINS=["*"]
