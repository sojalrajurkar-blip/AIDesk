{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "routes": [
    {
      "src": "/downloads/(.*)",
      "dest": "/downloads/$1",
      "headers": {
        "Content-Disposition": "attachment"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
