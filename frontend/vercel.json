{
  "version": 2,
  "cleanUrls": true,
  "public": true,
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!downloads/|assets/|canvaskit/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
