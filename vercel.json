{
  "version": 2,
  "cleanUrls": true,
  "public": true,
  "outputDirectory": "frontend/build/web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!downloads/|assets/|canvaskit/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
